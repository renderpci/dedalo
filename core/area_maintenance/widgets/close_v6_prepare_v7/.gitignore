# Runtime + per-install artifacts — never commit.
#
# NOTE: engine/, run/ and widget/ ARE tracked on purpose. This package must run from a
# plain v6 checkout: no build step, no snapshot to regenerate, no other repository.
/var/
/private/
/cache/
/sessions/
/backups/
# ^ config-migration quarantine: holds the imported v6 config, i.e. the DB password

# --- re-include the package's config/ directories -----------------------------
# The repo-root .gitignore carries a blanket `config/*` rule (a v6 install keeps its
# secrets in config/). Inside this package the config/ directories are SOURCE, not
# per-install state: engine/config/ is the engine entry point (bootstrap.php, the
# sample.* templates, nginx.conf.sample) and engine/core/base/config/ is the config
# catalog. Without these negations their files are invisible to git and only ever
# reach the branch through `git add -f`, so new ones silently never sync.
# Everything below this block is re-ignored on top of the negation — keep the
# runtime/secret patterns AFTER it, or they stop applying inside config/.
!**/config/
!**/config/**

# Same story, two more root rules that swallow package source:
#   root `acc`     (line 25)  -> engine/core/db/acc/, the legacy v6 record classes
#                               build_package.sh ships (RecordObj_dd, JSON_RecordObj_matrix,
#                               RecordDataBoundObject, RecordObj_time_machine, search_v6).
#   root `backups` (line 101) -> engine/diffusion/migration/helpers/backups/, the hand-written
#                               parity-baseline restore SQL. Note helpers/.gitignore ignores
#                               only out/ and baseline/ — backups/ was always meant to be source.
# The package-root /backups/ quarantine above stays ignored: different path, it holds the
# imported v6 config (DB password).
!/engine/core/db/acc/
!/engine/core/db/acc/**
!/engine/diffusion/migration/helpers/backups/
!/engine/diffusion/migration/helpers/backups/**

*.log
.DS_Store

# generated at runtime by the widget: a literal snapshot of the live v6 config (0600),
# and the shim the engine's config migration writes next to it
/engine/config/config.php
/engine/config/config_*.php
/engine/config/.env
/engine/config/.env.*
/engine/config/bootstrap/
/engine/.env
/engine/.env.*
