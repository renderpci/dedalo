          {
            "lang": "lg-nep",
            "name": "confirm_activate",
            "value": "यो पदानुक्रम सक्रिय / मर्मत गर्ने?\n\nहराइरहेको कुरा मात्र सिर्जना गरिनेछ। केही पनि मेटिँदैन।"
          },
