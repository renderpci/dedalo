            "lang": "lg-spa",
            "name": "confirm_activate",
            "value": "¿Activar / reparar esta jerarquía?\n\nSolo se creará lo que falte. No se borra nada."
          },
          {
            "lang": "lg-cat",
            "name": "confirm_activate",
            "value": "Activar / reparar aquesta jerarquia?\n\nNomés es crearà el que falti. No s'esborra res."
          },
          {
            "lang": "lg-eus",
            "name": "confirm_activate",
            "value": "Hierarkia hau aktibatu / konpondu?\n\nFalta dena bakarrik sortuko da. Ez da ezer ezabatzen."
          },
          {
            "lang": "lg-fra",
            "name": "confirm_activate",
            "value": "Activer / réparer cette hiérarchie ?\n\nSeul ce qui manque sera créé. Rien n'est supprimé."
          },
          {
            "lang": "lg-por",
            "name": "confirm_activate",
            "value": "Ativar / reparar esta hierarquia?\n\nApenas o que falta será criado. Nada é eliminado."
          },
          {
            "lang": "lg-deu",
            "name": "confirm_activate",
            "value": "Diese Hierarchie aktivieren / reparieren?\n\nEs wird nur erstellt, was fehlt. Es wird nichts gelöscht."
          },
          {
            "lang": "lg-ita",
            "name": "confirm_activate",
            "value": "Attivare / riparare questa gerarchia?\n\nVerrà creato solo ciò che manca. Non viene eliminato nulla."
