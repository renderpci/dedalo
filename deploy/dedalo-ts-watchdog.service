# Dédalo TS watchdog — one-shot health probe (audit S2-38).
#
# /health checks liveness AND database reachability (audit S3-48): it answers
# 503 when Postgres is down or the pool is wedged, so this probe catches the
# "process alive but service dead" class systemd's Restart=always cannot see.
# Enabled by dedalo-ts-watchdog.timer (every 30 s).

[Unit]
Description=Dedalo TS health watchdog (curl /health over the unix socket)
Requisite=dedalo-ts.service
After=dedalo-ts.service

[Service]
Type=oneshot
# The probe script curls /health (--fail, --max-time 10) and on red CHOOSES the
# remedy itself: a pending unconfirmed code update → dedalo-ts-rollback.service
# (restarting freshly swapped-in broken code would only re-run it); otherwise →
# dedalo-ts-restart.service, exactly as before. No OnFailure= here — the script
# starts the remedy unit directly, and an OnFailure restart would race the
# rollback it just started. Match --socket to SERVER_UNIX_SOCKET in
# ../private/.env (canonical: /run/dedalo/dedalo_ts.sock).
#
# ExecStart points at the OUT-OF-TREE install (/opt/dedalo/bin/), like the
# rollback unit: the probe must keep running while the app tree is mid-swap
# or gone. Install + refresh after updates (PRODUCTION.md §12):
#   sudo install -m 0755 deploy/dedalo-ts-watchdog.sh /opt/dedalo/bin/
# The script resolves the code-backup root (for the sentinel) the same way
# the engine does: env DEDALO_BACKUP_PATH, then <private>/.env, then default.
ExecStart=/opt/dedalo/bin/dedalo-ts-watchdog.sh \
    --socket /run/dedalo/dedalo_ts.sock \
    --app-dir /opt/dedalo/master_dedalo
