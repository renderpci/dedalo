# Dédalo nightly backup — store 5, every site-builder INSTANCE on this host
# (reference unit, the single-instance layout of engineering/PRODUCTION.md; the
# terminal installer renders its own per-instance twin,
# deploy/systemd/dedalo-backup-site-builder@.service).
#
# WHY A UNIT OF ITS OWN, AS ROOT. An instance's secrets are 0600 root:root inside
# a 0700 root:root directory, and its state roots are 0750 owned by that museum's
# own service user. DEDALO_USER is in none of those groups — deliberately, that
# separation IS the isolation — so this store must run as root. It used to be a
# `+` (root) line inside dedalo-backup.service, and that was an escalation:
#
#   - systemd applies a unit's EnvironmentFile= to EVERY ExecStart, `+` lines
#     included, and dedalo-backup.service reads /opt/dedalo/private/.env — a file
#     DEDALO_USER writes. An LD_PRELOAD or PATH there ran as root.
#   - the scripts ran from /opt/dedalo/master_dedalo/deploy/, which DEDALO_USER
#     owns: editing them was running code as root.
#   - its verdict and destination sat under /opt/dedalo/backups, DEDALO_USER's
#     too: a symlink planted there redirected a root write.
#
# So here: NO EnvironmentFile (the store reads the provisioner's own artifacts,
# never the engine's .env), fixed Environment= lines, both scripts from the
# ROOT-OWNED /opt/dedalo/bin/ (install them there — engineering/PRODUCTION.md §6;
# /opt/dedalo itself must stay root-owned, or DEDALO_USER could rename bin/), and
# a root-owned verdict and destination outside every tree DEDALO_USER writes.
#
# Pulled in by dedalo-backup.service (its Wants=) and ordered after it, so the
# nightly timer still runs the whole set; a failure raises the same alarm as any
# other store. It is the last (and only) store of THIS unit, hence `--last`: it
# aggregates its own verdict. Exits 0 with one line on a host that declares no
# site-builder instance.
#
# The destination holds root-owned 0600 credentials: it is created 0700 root:root
# (UMask below) and the whole backup tree is secret material.
#
#   sudo install -m 0755 deploy/dedalo-backup-step.sh deploy/dedalo-site-builder-backup.sh /opt/dedalo/bin/
#   sudo cp deploy/dedalo-backup-site-builder.service /etc/systemd/system/

[Unit]
Description=Dedalo nightly backup — site-builder instances (host-wide, root)
After=dedalo-backup.service
# %n is this unit's own name, so the alarm can quote the right journal.
OnFailure=dedalo-backup-alert@%n.service

[Service]
Type=oneshot
UMask=0077
# The per-run store statuses (removed when the unit stops) — root's, 0700.
RuntimeDirectory=dedalo-backup-site-builder
RuntimeDirectoryMode=0700
# The PERSISTENT verdict (BACKUP_FAILED / LAST_OK) — root-owned, outside the
# backup tree DEDALO_USER writes. QUOTED as a whole (campaign 2 L8).
Environment="DEDALO_BACKUP_STATE_DIR=/var/lib/dedalo/backup-site-builder"
Environment="DEDALO_BACKUP_EXPECTED_STORES=site_builder"
# 5. Every site-builder instance: its declaration + secrets, its workspaces root,
#    each site's whole webspace (BOTH release stores and the two served symlinks),
#    and its audit trail.
ExecStart=/opt/dedalo/bin/dedalo-backup-step.sh run --last site_builder /opt/dedalo/bin/dedalo-site-builder-backup.sh /var/backups/dedalo-site-builder
