# Roll back one instance's failed code update (written by the installer).
#
# THE FILE WORK RUNS AS THE INSTANCE USER: every tree the script moves (the
# app tree, the backed-up tree, the failed tree's parking place) and the
# sentinel it reads are the instance's, under its home — so the instance's own
# account does it, and a root process never reads the instance-written
# sentinel or moves a path named in it. The backup root is PINNED here (never
# resolved from the instance's .env). Only the restart runs as root
# (ExecStartPost=+, a fixed systemctl line). ExecCondition= skips the unit —
# restart included — when no pending, unattempted update is recorded. The
# script itself runs from the ROOT-OWNED copy in /opt/dedalo/instances/<i>/bin,
# never from the instance's tree (F2).

[Unit]
Description=Roll back a failed Dedalo code update of %i to the previous tree

[Service]
Type=oneshot
User=ded_%i
Group=ded_%i
UMask=0027
ExecCondition=/opt/dedalo/instances/%i/bin/dedalo-code-rollback.sh --check --app-dir /home/ded_%i/dedalo --backup-root /home/ded_%i/backups/code
ExecStart=/opt/dedalo/instances/%i/bin/dedalo-code-rollback.sh --no-restart --app-dir /home/ded_%i/dedalo --backup-root /home/ded_%i/backups/code --service dedalo-ts@%i --socket /run/dedalo-%i/dedalo_ts.sock
ExecStartPost=+/usr/bin/systemctl reset-failed dedalo-ts@%i.service
ExecStartPost=+/usr/bin/systemctl start --no-block dedalo-ts@%i.service
