# One instance's health watchdog (written by the installer; armed by its timer
# only AFTER the first boot completed — host_watchdog). The script skips while
# the server is younger than --grace (boot migrations run before the socket
# binds: a watchdog without a grace killed them — campaign 2 L7, finding F3).
# It runs as root (it starts the restart/rollback units), so the backup root is
# PINNED here: it never resolves it from the instance's .env, and it only
# reads (greps) the instance-written sentinel — the rollback acts as the
# instance user (dedalo-ts-rollback@).

[Unit]
Description=Dedalo TS health watchdog — %i
Requisite=dedalo-ts@%i.service
After=dedalo-ts@%i.service

[Service]
Type=oneshot
ExecStart=/opt/dedalo/instances/%i/bin/dedalo-ts-watchdog.sh --socket /run/dedalo-%i/dedalo_ts.sock --app-dir /home/ded_%i/dedalo --backup-root /home/ded_%i/backups/code --service dedalo-ts@%i.service --grace 900 --restart-unit dedalo-ts-restart@%i.service --rollback-unit dedalo-ts-rollback@%i.service
