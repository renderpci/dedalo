# Test environment — the suite's own instance, parsed by src/config.ts itself.
#
# THIS FILE IS THE SOURCE, not a hint. The daemon builds its configuration by PARSING the
# named env file (this one under NODE_ENV=test), merging a tiny ambient allowlist and
# layering $CREDENTIALS_DIRECTORY on top — the same three steps on a laptop, in the suite
# and on a museum's host. Relative paths below resolve against THIS FILE's directory, so
# `bun test` means the same roots wherever it is started from.
#
# The instance this scratch tree belongs to. Must equal INSTANCE in
# tests/fixtures/instance.ts — tests/seam_tripwire.test.ts asserts they agree, because a
# silent disagreement would mark the roots for one instance and boot the daemon as another.
DEDALO_SITE_INSTANCE=test

# A secret in an env file is refused on a PROVISIONED host (assertNoLegacyEnv): there it
# arrives as a systemd credential out of a root-owned file. A suite has no systemd and no
# credential store, so here it is the only door there is — which is exactly the condition
# that refusal is scoped to.
SERVICE_TOKEN=test-service-token-000000000000000000000000

# The four roots, all inside one scratch tree the suite creates, marks and destroys. The
# served surfaces are NOT among them: a site's `pre` and `web` live inside that site's own
# webspace under WEBSPACE_BASE, which is why PREPROD_ROOT/PROD_ROOT are gone.
SITES_ROOT=./.test-tmp/workspaces
AGENT_HOME=./.test-tmp/agent_home
AUDIT_DIR=./.test-tmp/audit
WEBSPACE_BASE=./.test-tmp/webspaces

# WHERE EVERY SITE OF THIS INSTANCE LIVES — the provisioner's table, which the daemon reads
# and never re-derives (src/sites/site_table.ts). The suite has no provisioner, so
# tests/fixtures/instance.ts renders this file with the provisioner's OWN renderer every
# time it declares a site: a fixture that hand-wrote it would be green on the day the two
# sides disagreed, which is the exact defect the table exists to close.
SITE_TABLE_FILE=./.test-tmp/config/test/sites.json

# A site's URL is built from its own domain (site.json) plus these two host facts, which a
# provisioned instance has rendered into its env from the declaration.
PREPROD_HOST_PREFIX=pre
PROD_URL_SCHEME=http
PUBLICATION_API_URL=http://publication.test/publication/server_api/v2
AGENT_DRIVER=claude_code
# Empty bins so driver detection reports unavailable in tests (no real CLIs installed) and
# the boot preflight's binary assertions have nothing to hold.
CLAUDE_CODE_BIN=
OPENCODE_BIN=
PI_BIN=
MAX_SITES=5

# A SMALL quota so the gate that proves it counts the RELEASE STORES (tests/webspace.test.ts)
# can exceed it with a few megabytes instead of a gigabyte. The default is 1024; what the
# gate asserts is the arithmetic and the refusal, neither of which depends on the number.
SITE_DISK_QUOTA_MB=8

# PROVIDER CREDENTIALS, PLACEHOLDER — so the PER-DRIVER SCOPING of the agent-secrets
# boundary is observable at all (tests/agent_boundary.test.ts §3). With every provider key
# empty, "Anthropic's key reaches claude_code and no other driver" has no positive case and
# the scoping test would pass against code that forwarded every key to every driver. These
# are placeholders, not secrets, and they are here for the same reason SERVICE_TOKEN is:
# a suite has no systemd credential store, and this file is the only door it has.
ANTHROPIC_API_KEY=placeholder-anthropic-key-for-the-boundary-gate
OPENCODE_ENV=OPENCODE_TOKEN=placeholder-opencode-key
PI_ENV=PI_TOKEN=placeholder-pi-key
PUBLICATION_API_KEY=placeholder-publication-key
