#
# Instance example: git's SYSTEM configuration inside every agent TURN unit, which
# binds this file read-only over /etc/gitconfig (the host's own is shadowed there).
# The agent CLI runs git itself in the workspace, whose .git the unit masks; git's discovery
# would then take the workspace ROOT as a bare repository and run what is planted in it.
# safe.bareRepository is honoured only from protected configuration — never a repository's.
# Nothing else: no safe.directory. The daemon refuses a turn when this file says anything else.
[safe]
	bareRepository = explicit
