[Unit]
Description=Dedalo site agent socket - example s2 turn
# Stopped WITH the daemon, in its transaction: a socket with a stop pending accepts no
# connection, so nothing activated during the daemon's stop can cancel it.
PartOf=dedalo-site-builder@example.service

[Socket]
ListenStream=/run/dedalo-sites-agents/example/s2-turn.sock
Accept=yes
MaxConnections=1
SocketUser=dedalo-site-example
SocketGroup=dedalo-site-example
SocketMode=0600
DirectoryMode=0755
TriggerLimitIntervalSec=2s
TriggerLimitBurst=20

[Install]
WantedBy=sockets.target
