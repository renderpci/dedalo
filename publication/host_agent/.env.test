# Test environment — the suite's own instance, parsed by src/config.ts itself.
#
# THIS FILE IS THE SOURCE, not a hint: under NODE_ENV=test with DEDALO_HOST_AGENT_ENV_FILE
# unset — and ONLY in a checkout whose .test-tmp/ the suite declared (tests/preload.ts; a
# deployed checkout has none, so it never boots in test mode from here) — src/config.ts
# PARSES this file, fills NODE_ENV / LOG_LEVEL from the ambient
# environment only where the file is silent, and lets $CREDENTIALS_DIRECTORY win for
# SERVICE_TOKEN — the same steps in the suite and on a publication host. The keys are the
# AgentConfig field names, exactly what the provisioner renders. Relative paths resolve
# against THIS FILE's directory, so `bun test` means the same roots wherever it is started
# from. Every root stays under ./.test-tmp/ (tests/fixtures/instance.ts refuses anything else).

# Must equal INSTANCE in tests/fixtures/instance.ts (tests/fixture_instance.test.ts).
INSTANCE=test
NODE_ENV=test

# The suite listens on a unix socket: no TLS material exists in a hermetic run. The mTLS
# listener is exercised by gates that write their own CA under the scratch tree.
LISTEN_KIND=unix
SOCKET_PATH=./.test-tmp/run/agent.sock

# A secret in an env file is accepted ONLY under NODE_ENV=test (src/config.ts refuses it
# otherwise): a provisioned host receives it as $CREDENTIALS_DIRECTORY/SERVICE_TOKEN.
SERVICE_TOKEN=test-service-token-000000000000000000000000

STATE_ROOT=./.test-tmp/state

WEB_SERVER=apache
WEB_UNIT=apache2

MEDIA_MODE=shared
MEDIA_ROOT=./.test-tmp/media

# Never executed by the suite: every child process goes through the exec seam, which the
# tests replace (setExecForTests). Absolute because the agent never searches PATH.
PHP_BIN=/usr/bin/php
BUN_BIN=/usr/local/bin/bun

V2_UNIT=dedalo-publication-v2-test
V2_HEALTH_URL=http://127.0.0.1:3100/dedalo/publication/server_api/v2/health
