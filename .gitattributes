# ---------------------------------------------------------------------------
# Generated CSS. The SOURCE is the .less; these are build OUTPUT (scripts/build_css.ts),
# committed because the deploy model is a checkout — `deploy/deploy.sh`: "the repo IS the
# artifact" — and production installs `--production`, so the LESS compiler never reaches
# the host. Nothing rebuilds CSS on the way out, so the bytes in git are the bytes the
# browser gets. `test/unit/css_build_tripwire.test.ts` keeps them honest.
#
# linguist-generated: collapses them in GitHub diffs and excludes them from language stats.
# They are still committed, still diffable locally, still reviewed by the tripwire — this
# only stops a one-line token change in layout/vars.less (which rebuilds 35 entrypoints,
# thousands of lines) from burying the actual change in a pull request.
#
# ON A MERGE CONFLICT in one of these files: do not hand-resolve it. Take either side, then
#   bun run css:build
# and commit the result. The .less files are the merge that matters; the CSS is derived.
#
# The `.css.map` is NOT here because it is no longer committed at all (2026-08-01, see
# .gitignore): a source map ships nothing, so the deploy argument above does not apply to
# it, and 45 machine-generated JSON blobs conflicting on every shared token change was pure
# friction. It is still built locally by `bun run css:build`.
# ---------------------------------------------------------------------------
client/dedalo/**/*.css      linguist-generated=true
tools/**/*.css              linguist-generated=true

# Third-party bundles we vendor verbatim — not our source, never reviewed as ours.
vendor/**  linguist-vendored=true

# The .less files ARE source: always diff them normally, never collapse.
*.less  linguist-generated=false

# ---------------------------------------------------------------------------
# Build provenance. Releases are `git archive --format=zip --prefix=dedalo_code/`
# exports (src/core/update/code_build.ts); export-subst makes git expand the
# `$Format:%H %cI$` placeholder in build_info.txt to the real `<sha> <ISO date>`
# INSIDE the archive. The checked-in file keeps the literal placeholder — that
# is how a dev checkout self-identifies (src/core/update/build_stamp.ts:
# placeholder → DEDALO_BUILD=null + '.dev' tag; expanded → release stamp).
# test/unit/build_stamp_native.test.ts refuses a committed expanded value.
# ---------------------------------------------------------------------------
src/core/update/build_info.txt export-subst

# ---------------------------------------------------------------------------
# Agent tooling aliases never ship in a release. CLAUDE.md -> AGENTS.md and
# .claude/ -> .agents/ are committed SYMLINKS (the vendor-neutral alias layout),
# and `git archive` stores symlinks as symlink entries — which the installer's
# zipinfo pre-validation REFUSES outright (code_update.ts: no symlink entry is
# ever extracted). Without export-ignore every release built from this checkout
# was uninstallable by construction (found by scripts/update_drill.ts).
# ---------------------------------------------------------------------------
/.claude export-ignore
/CLAUDE.md export-ignore
